# Exemplo de configuração local. Copie para .env e preencha os valores.
# NÃO coloque segredos reais neste arquivo.

# PostgreSQL (o schema Prisma atual usa provider "postgresql")
DATABASE_URL="postgresql://usuario:senha@localhost:5432/pixtune?schema=public"

# Autenticação
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# Ambiente
NODE_ENV=development
API_URL="http://localhost:3001"
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Spotify OAuth (Developer Dashboard)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:3001/api/auth/spotify/callback"
SPOTIFY_CONNECT_REDIRECT_URI="http://localhost:3001/api/spotify/callback"
