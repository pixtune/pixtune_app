# PixTune - Environment Variables
# Copie este arquivo para .env e preencha os valores

# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database (SQLite local file)
DATABASE_URL="file:./prisma/dev.db"

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=7d

# A integração Live Pix é configurada pela interface (Configurações > Live Pix).
# As credenciais ficam no banco local, não neste arquivo.

# YouTube / Music Provider
# A reprodução usa a IFrame Player API oficial (não requer chave).
# A busca automática do vídeo a partir do nome da música usa a YouTube Data API v3.
# Crie uma chave gratuita no Google Cloud Console, ative "YouTube Data API v3"
# e cole abaixo. Sem a chave, o pedido entra na fila aguardando um link.
YOUTUBE_API_KEY=

# Firebase Authentication (login com Google) + Firebase Hosting.
# 1) Crie um projeto em https://console.firebase.google.com
# 2) Ative Authentication > Sign-in method > Google.
# 3) Registre um app Web e copie a configuração para as VITE_FIREBASE_* abaixo
#    (é a config PÚBLICA — pode ficar no cliente).
# 4) Pronto! O servidor valida o ID token apenas com o project ID acima
#    (a assinatura é conferida com as chaves públicas do Google) — não é
#    obrigatório baixar uma conta de serviço.
#    Opcional: para habilitar a checagem de revogação de token, baixe a chave
#    da conta de serviço (Configurações do projeto > Contas de serviço >
#    Gerar nova chave privada) e aponte GOOGLE_APPLICATION_CREDENTIALS para o
#    arquivo, OU cole o JSON inteiro em uma linha em FIREBASE_SERVICE_ACCOUNT.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=

# Conexão do canal do YouTube (OAuth 2.0) — apenas para LER os dados do canal.
# Crie um OAuth Client ID do tipo "Aplicativo da Web" no Google Cloud Console
# e cadastre EXATAMENTE esta URI de redirecionamento autorizado:
#   http://localhost:3001/api/youtube/callback
# Na tela de consentimento, adicione o escopo youtube.readonly e inclua sua
# conta como usuário de teste enquanto o app estiver em modo de teste.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Aliases aceitos (opcionais): GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.

# CORS: origens permitidas na API, separadas por vírgula.
# Em produção (ex.: Firebase Hosting) inclua o domínio:
#   https://seu-projeto.web.app,https://seu-dominio.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000