# PixTune - exemplo de ambiente
# Copie para .env e preencha os valores.

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Banco local (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Auth
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Spotify (developer.spotify.com/dashboard)
# Cadastre exatamente a mesma URI de redirecionamento no painel do Spotify.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:3001/api/spotify/callback"

# A integração Live Pix é configurada pela interface (Configurações > Live Pix).
